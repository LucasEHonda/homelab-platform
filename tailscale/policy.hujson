// Fragment to merge into the tailnet policy file (Tailscale admin -> Access controls).
// Only these additions are needed; keep your existing grants. Do not add broad grants for
// autogroup:member: apps decide who sees them through their own grants.
{
  "tagOwners": {
    "tag:ci": ["autogroup:admin"],
    "tag:deployer": ["autogroup:admin"],
    "tag:secrets": ["autogroup:admin"]
  },
  "grants": [
    // Ephemeral GitHub Actions runners: only the deployer's HTTPS endpoint.
    { "src": ["tag:ci"], "dst": ["tag:deployer"], "ip": ["tcp:443"] }
  ],
  // Rejects the policy on save if a CI runner could reach anything but the deployer.
  "tests": [
    { "src": "tag:ci", "accept": ["tag:deployer:443"], "deny": ["tag:secrets:443"] }
  ]
}
